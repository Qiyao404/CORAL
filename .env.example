# CORAL 平台环境变量配置模板 — 复制为 .env 后按需修改

# ───── 服务端 ─────
PORT=3001
# 安全默认：仅本机监听（需要局域网访问时改为 0.0.0.0 并自行承担风险）
HOST=127.0.0.1
# CORS 白名单（逗号分隔，默认已含 Vite dev 源与服务自身源）
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ───── LLM 配置（默认：阿里云 DashScope Coding，任何 OpenAI 兼容端点均可）─────
LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=kimi-k2.5
LLM_PROFILE_NAME=DashScope Coding · kimi-k2.5

# LLM 传输层重试（网络抖动 / 429 / 5xx 自动退避重试；4xx 鉴权/参数错误不重试）
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_MS=500

# 显式演示模式（也可以用启动参数 --demo 开启）：
# 所有 LLM 调用返回带 mock: true 标记的模拟数据，无需 API Key 即可体验全链路
# CORAL_DEMO_MODE=false

# shell_run 内置工具（D13 安全默认：关闭；开启后每次执行仍需人工审批）
# SHELL_TOOL_ENABLED=false

# Free 模式 run 预算默认值（每次请求可覆盖；防止 agent 失控烧钱）
RUN_MAX_STEPS=25
RUN_MAX_TOKENS=200000

# ───── 数据存储（SQLite，单文件零配置）─────
DATABASE_PATH=./data/coral.db

# ───── Skill 运行时 ─────
SKILLS_DIR=./skills
SCENARIO_PACKS_DIR=./scenario-packs
SKILL_WATCHER_DEBOUNCE_MS=300
SKILL_DEFAULT_TIMEOUT_MS=180000

# ───── 脚本沙箱 ─────
SANDBOX_MODE=process
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_NETWORK_ENABLED=true

# ───── 调度 ─────
MAX_CONCURRENT_TASKS=50
MAX_CONCURRENT_AGENTS_PER_TASK=10
AGENT_DEFAULT_TIMEOUT_MS=300000
AGENT_MAX_RETRIES=2

# ───── 人工审批（M2 实装）─────
HUMAN_GATE_TIMEOUT_MS=86400000
HUMAN_GATE_AUTO_REJECT=true

# ───── 政策抓取（代理友好）─────
# 代理打开时（HTTP_PROXY/HTTPS_PROXY），政府站点访问可能失败；
# 允许脚本在每次请求前为这些域名关掉代理直连
POLICY_NO_PROXY_DOMAINS=gov.cn,foshan.gov.cn,gd.gov.cn
POLICY_FORCE_DIRECT=true

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": false,
    "resolveJsonModule": true
  },
  "include": [
    "src/index.ts",
    "src/mcp/serve.ts",
    "src/cli/doctor.ts",
    "src/embedded.ts"
  ]
}
